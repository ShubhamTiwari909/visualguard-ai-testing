---
import Default from '@astrojs/starlight/components/PageTitle.astro';
const { entry } = Astro.locals.starlightRoute;
const data = entry.data;
---
<Default {...Astro.props}><slot /></Default>
{data.template !== 'splash' && (
  <aside class="release-notice" aria-label="Guide applicability">
    <strong>{data.channel === 'source' ? 'Source checkout' : data.channel === 'published' ? 'npm package' : 'Package & source'}</strong>
    <span>{data.verifiedAgainst}</span>
    <span>Reviewed {data.lastReviewed}</span>
  </aside>
)}
