# Google sign-in and invitations (P03). Copy to apps/platform/.env.local, then load it
# explicitly from the repository root before starting the source dashboard:
# set -a
# source apps/platform/.env.local
# set +a
# pnpm platform:dev
# The source dashboard does not automatically load this file.

# Required explicit choice for installations upgrading with existing users.
# invite: unknown identities need invitations; existing identities keep signing in.
# legacy: retain the previous automatic OIDC account creation temporarily.
VISUALGUARD_USER_ADMISSION=invite
VISUALGUARD_AUTH_MODE=login
VISUALGUARD_PUBLIC_URL=http://127.0.0.1:4400
VISUALGUARD_OIDC_ISSUER=https://accounts.google.com
VISUALGUARD_OIDC_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
VISUALGUARD_OIDC_CLIENT_SECRET='replace-with-google-client-secret'

# Initial setup creates the password administrator below. Sign in with that
# password, then link Google in Settings to keep the same administrator account.
# With no password configured, the first matching verified Google login can
# bootstrap the administrator. Later callbacks never promote existing users.
VISUALGUARD_ADMIN_EMAIL=replace-with-your-google-email@example.com
VISUALGUARD_ADMIN_PASSWORD='replace-with-a-unique-password-of-at-least-12-characters'

# Optional. Leave unset to use local SQLite; do not export placeholder URLs.
# VISUALGUARD_DATABASE_URL=postgresql://actual-user:actual-password@localhost:5432/actual-database
# Invitations/linking require replica-set or sharded MongoDB:
# VISUALGUARD_DATABASE_URL=mongodb://localhost:27017/actual-database?replicaSet=rs0
# VISUALGUARD_PLATFORM_DATA_DIR=/absolute/path/to/disposable-google-pilot-data
