{
  "name": "visualguard",
  "version": "0.1.0",
  "description": "AI visual regression agent: compare production and staging, explain every visual difference, and fix regressions.",
  "keywords": [
    "visual regression",
    "screenshot testing",
    "playwright",
    "ai",
    "gemini",
    "ollama",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "visualguard": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "p-limit": "^7.3.3",
    "picocolors": "^1.1.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "playwright": ">=1.45.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pngjs": "^6.0.5",
    "playwright": "1.64.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
