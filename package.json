{
  "name": "visualguard-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "platform:dev": "pnpm --filter @visualguard/platform dev",
    "platform:start": "pnpm --filter @visualguard/platform start",
    "platform:build": "pnpm --filter @visualguard/platform build",
    "platform:test": "pnpm --filter @visualguard/platform test",
    "platform:test:package": "node scripts/standalone-dashboard-smoke.mjs",
    "platform:test:runner": "node scripts/dashboard-runner-smoke.mjs",
    "platform:import": "pnpm --filter @visualguard/platform run import",
    "platform:publish": "pnpm --filter @visualguard/platform run publish:run",
    "platform:operations": "pnpm --filter @visualguard/platform run operations",
    "build": "pnpm --filter visualguard build",
    "test": "pnpm --filter visualguard test",
    "typecheck": "pnpm --filter visualguard typecheck && pnpm --filter @visualguard/platform typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "test:pack": "pnpm build && node scripts/pack-smoke.mjs",
    "eval": "pnpm build && node evals/run.mjs",
    "demo:gif": "pnpm build && node scripts/demo-gif.mjs",
    "docs:dev": "pnpm --filter @visualguard/docs dev",
    "docs:build": "pnpm --filter @visualguard/docs build",
    "docs:preview": "pnpm --filter @visualguard/docs preview",
    "docs:test": "node --test scripts/docs/checks.test.mjs && node scripts/docs/check-content.mjs && node scripts/docs/check-examples.mjs && node scripts/docs/generate-reference.mjs --check",
    "docs:check-links": "node scripts/docs/check-links.mjs",
    "docs:smoke": "node scripts/docs/smoke-quickstart.mjs --dashboard",
    "docs:smoke:host": "node scripts/docs/smoke-dashboard-host.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.12.0",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
