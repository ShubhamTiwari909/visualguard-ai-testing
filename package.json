{
  "name": "visualguard-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter visualguard build",
    "test": "pnpm --filter visualguard test",
    "typecheck": "pnpm --filter visualguard typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "test:pack": "pnpm build && node scripts/pack-smoke.mjs",
    "eval": "pnpm build && node evals/run.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
